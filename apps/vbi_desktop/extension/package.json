{
  "name": "vbi-vscode-extension",
  "displayName": "VBI Chart Viewer",
  "description": "A lightweight VS Code extension to render SQL data charts.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vbi.showChart"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vbi.showChart",
        "title": "VBI: Show Chart"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.115.0",
    "typescript": "^5.9.3"
  }
}
